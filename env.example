# Copy to ~/.config/nas-movie/env and edit. One KEY=VALUE per line; quote values with spaces.
# Read by the CLI on start-up and by deploy-nas.sh; deploy copies it to the NAS.

# ssh config host name of your NAS (used by deploy-nas.sh)
NAS_SSH=nas

# Flat JAV library: every file becomes "YYYY-MM-DD CODE Actress.ext"
NAS_MOVIE_ARCHIVE=/home/me/Media/JAV
# TV / anime library: Show/Season 01/Show - S01E03.mkv
NAS_MOVIE_SHOWS_ROOT=/home/me/Media/Shows
# Where organize moves torrents, ads and leftovers (never deleted directly)
NAS_MOVIE_TRASH=/home/me/.nas-movie-trash

# Teacher roster = a bookmark folder of Jable actress pages (Edge/Chrome bookmark format).
# Leave HOST empty when the browser runs on the machine that runs the CLI.
NAS_MOVIE_BOOKMARKS_HOST=
NAS_MOVIE_BOOKMARKS_FILE="C:/Users/me/AppData/Local/Microsoft/Edge/User Data/Default/Bookmarks"
NAS_MOVIE_BOOKMARKS_FOLDER=Teachers

# HTTP proxy on the NAS for javdb.com and sukebei (e.g. mihomo/clash). deploy-nas.sh default.
# NAS_MOVIE_PROXY=http://127.0.0.1:7890
